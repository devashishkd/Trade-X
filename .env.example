# ─── Shared Secrets (use same value across all services) ───────────────────
JWT_SECRET=change_this_to_a_long_random_string
INTERNAL_SERVICE_KEY=change_this_to_another_long_random_string

# ─── Auth Service ───────────────────────────────────────────────────────────
AUTH_PORT=3001
AUTH_MONGO_URI=mongodb://localhost:27017/auth-db
INITIAL_WALLET_BALANCE=100000
JWT_EXPIRES_IN=86400

# ─── Order Service ──────────────────────────────────────────────────────────
ORDER_PORT=3002
ORDER_MONGO_URI=mongodb://localhost:27017/order-db

# ─── Matching Engine ────────────────────────────────────────────────────────
ENGINE_PORT=3003
SLIPPAGE_PROTECTION_PCT=0.02

# ─── Portfolio Service ──────────────────────────────────────────────────────
PORTFOLIO_PORT=3004
PORTFOLIO_MONGO_URI=mongodb://localhost:27017/portfolio-db

# ─── Market Data Service ────────────────────────────────────────────────────
MARKET_PORT=3005
MARKET_MONGO_URI=mongodb://localhost:27017/market-db

# ─── API Gateway ────────────────────────────────────────────────────────────
GATEWAY_PORT=3000

# ─── Service URLs (used between services) ───────────────────────────────────
AUTH_SERVICE_URL=http://localhost:3001
ORDER_SERVICE_URL=http://localhost:3002
MATCHING_ENGINE_URL=http://localhost:3003
PORTFOLIO_SERVICE_URL=http://localhost:3004
MARKET_DATA_SERVICE_URL=http://localhost:3005
