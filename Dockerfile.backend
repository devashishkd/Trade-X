FROM node:20-alpine

WORKDIR /app

# Copy the entire monorepo source code
# This is necessary because of npm workspaces linking @trade-x/shared
COPY . .

# Install dependencies for all workspaces
RUN npm ci

# Build shared library first so other workspaces can resolve it
RUN npm run build --workspace=@trade-x/shared

# Build all backend workspaces
RUN npm run build --workspace=backend/auth-service
RUN npm run build --workspace=backend/order-service
RUN npm run build --workspace=backend/portfolio-service
RUN npm run build --workspace=backend/market-data-service
RUN npm run build --workspace=backend/matching-engine
RUN npm run build --workspace=backend/api-gateway

# Set the default command (will be overridden by docker-compose)
CMD ["node"]
